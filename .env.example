# =============================================================================
# AI Provider Configuration
# =============================================================================
# LLM_PROVIDER controls ALL text and vision inference routing.
# Supported: vllm (default), ollama, gemini
# - vllm:   Qwen3-VL + any instruct model via vLLM OpenAI-compatible endpoint.
#           Works for local vLLM and hosted endpoints (Together, Fireworks, etc.)
# - ollama: Local Ollama (dev convenience, slower). Use when you have no GPU/vLLM.
# - gemini: Google Gemini cloud API (requires GOOGLE_API_KEY).
#
# IMPORTANT: There is NO silent fallback. If vLLM is unreachable you will get
# a clear connection error. To switch to Ollama for dev: LLM_PROVIDER=ollama
LLM_PROVIDER=vllm

# vLLM endpoint settings (used when LLM_PROVIDER=vllm)
VLLM_BASE_URL=http://localhost:8000
# Stable logical name (used for cache keys and observability):
VLM_MODEL_ID=Qwen3-VL-2B-Instruct
# Exact model name sent to /v1/chat/completions (must match what vLLM serves):
VLM_ENDPOINT_MODEL_NAME=Qwen/Qwen3-VL-2B-Instruct
# API key if required (leave empty for local vLLM without auth):
# VLLM_API_KEY=

# Ollama (dev convenience — used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
AGENT_MODEL=llama3.1

# Metadata
TMDB_API_KEY=your_tmdb_key_if_you_have_one

# Database
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Hardware
DEVICE_OVERRIDE=cuda

# Frontend (optional - defaults shown)
# VITE_API_URL=http://localhost:8000

# Processing Settings (tune for your hardware)
# Lower values = more processing, better detection, but slower and higher memory
FRAME_INTERVAL=5                    # Extract frames every N seconds (default: 5)
FRAME_SAMPLE_RATIO=2                # Process every Nth extracted frame (default: 2)
FACE_DETECTION_THRESHOLD=0.5        # Face confidence 0.3-0.9 (lower=more faces, default: 0.5)
FACE_DETECTION_RESOLUTION=640       # 320=fast, 640=balanced, 960=accurate (default: 640)

# HuggingFace token (for downloading gated models like Pyannote)
HF_TOKEN=your_token_here
HF_HUB_ENABLE_HF_TRANSFER=1

# =============================================================================
# Optional Enrichment Models (default: disabled)
# =============================================================================
# Enable these only if you need the feature AND have installed the enrichment group:
#   uv sync --group enrichment
#
# Face recognition (InsightFace ArcFace):
#   buffalo_sc = compact ~300MB, good accuracy (default)
#   buffalo_l  = full accuracy, ~1GB
# ENABLE_FACE_RECOGNITION=true       # default: true (uses buffalo_sc)
# INSIGHTFACE_MODEL=buffalo_sc       # default: buffalo_sc
#
# Speech Emotion Recognition (Wav2Vec2):
# ENABLE_SPEECH_EMOTION=false        # default: false (no model load when off)

PYTHONPYCACHEPREFIX=.cache/pycache

# Langfuse Observability (Optional)
# Valid values: disabled, docker, cloud
LANGFUSE_BACKEND=disabled

# Docker Langfuse (uncomment if using local Docker instance)
# See docs/configuration.md for full setup instructions
# 1. Run: docker compose --profile docker up -d
# 2. Go to http://localhost:3300 and create account + project
# 3. Get API keys from Settings -> API Keys
# 4. Fill in the values below, then run start.ps1/start.sh (it auto-generates OTEL header)
# LANGFUSE_BACKEND=docker
# LANGFUSE_HOST=http://localhost:3300
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3300/api/public/otel

# Cloud Langfuse (uncomment if using Langfuse Cloud)
# LANGFUSE_BACKEND=cloud
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel

# This maps the backend setting to the Docker Profile system
COMPOSE_PROFILES=${LANGFUSE_BACKEND}
